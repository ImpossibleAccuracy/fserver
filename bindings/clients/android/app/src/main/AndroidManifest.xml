<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Every permission the user is prompted for is declared here, including the ones the modules
      below need: :core, :files and :net:transport:android declare only what they cannot run
      without and what the user never sees. The tokens themselves come from RequirementRules.kt in
      :core - dropping one here turns that feature off rather than breaking it, because
      RequirementsCheckerImpl reports an undeclared permission as a blocker.
    -->

    <!--  File system integration permissions  -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage" />
    <!-- for MediaStore -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Before scoped storage the media write went through the file - LegacyMediaFileSystem. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="PhotoAndVideoPolicy" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:ignore="PhotoAndVideoPolicy" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- API 34+: user may grant access to a chosen subset instead of the whole library. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- QR scanning; a device without a camera still pairs by typed address. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      Nearby Connections, which :net:transport:android drives. One runtime permission per action it
      performs; the install-time BLUETOOTH/BLUETOOTH_ADMIN pair they supersede stays in that module.

      `android:minSdkVersion` on a uses-permission is not a platform attribute and the package
      manager ignores it - these are declared on every api level. It records which level actually
      asks for the permission, which is RequirementRules.kt's answer, not the manifest's.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:minSdkVersion="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />
    <!--
      neverForLocation is load-bearing, not decoration: without it the platform keeps treating the
      BLE scan as location-derived, and the API 33+ rules in RequirementRules.kt - which stop asking
      for a location permission - would leave Nearby's BLE half silently finding nothing.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:minSdkVersion="31"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- Replaces the location gate for Wi-Fi Direct / Aware. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:minSdkVersion="33"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!--
      Two callers, and they end at different api levels: Nearby needs location for BLE and Wi-Fi
      Direct up to API 32, and reading the current network's name (SSID/BSSID) stays location-gated
      on every level - see networkInfoRequirementRules. Uncapped for the second one.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Viewer playback continuing in the background, under a media notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- One-shot transfers keep the process up while bytes move. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".FServerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FServer">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FServer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Share-sheet target. Its own activity: the main one's view model runs the node for the UI,
          and a second instance of it would start and stop that alongside the first.
        -->
        <activity
            android:name=".presentation.share.ShareActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.FServer">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.oneshot.OneShotTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".data.oneshot.OneShotOfferReceiver"
            android:exported="false" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Hands a scanned file to a system viewer: the scan reports absolute paths, which
             no other app may read directly. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>