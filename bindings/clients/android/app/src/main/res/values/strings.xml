    <string name="method_grant">Grant</string>
    <string name="method_grant_rest">Grant the rest</string>
    <string name="method_setup_note">Once everything is granted the method ticks itself. You still start the search.</string>

    <!-- What can stand between a method and a working search -->
    <string name="requirement_permission_location_title">Location</string>
    <string name="requirement_permission_location_description">Android treats network names and nearby scans as location data. Your coordinates are never read.</string>
