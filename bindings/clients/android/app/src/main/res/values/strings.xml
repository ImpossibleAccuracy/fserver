    <string name="requirement_toggle_wifi_description">Switch it on in system settings.</string>
    <string name="requirement_toggle_location_title">Location services are off</string>
    <string name="requirement_toggle_location_description">Switch them on in system settings.</string>
    <string name="requirement_play_services_title">Google Play services</string>
    <string name="requirement_play_services_description">Nearby search ships inside Play services and needs them installed and up to date.</string>
