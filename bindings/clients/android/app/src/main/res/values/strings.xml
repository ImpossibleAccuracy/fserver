    <!-- Onboarding -->
    <string name="onboarding_illustration_devices">illustration: two devices</string>
    <string name="onboarding_title_purpose">Your files on every device</string>
    <string name="onboarding_body_purpose">The app finds your computer on the same network and transfers files directly, without a cloud. The connection is always encrypted.</string>
    <string name="onboarding_illustration_permissions">illustration: network permission</string>
    <string name="onboarding_title_permissions">Access to the local network</string>
    <string name="onboarding_body_permissions">Android asks for permission to see devices on your Wi-Fi. Without it the app cannot find your computer.</string>
    <string name="onboarding_illustration_connect">illustration: code on the server screen</string>
    <string name="onboarding_title_connect">Connect your computer</string>
    <string name="onboarding_body_connect">Start the server on your PC or NAS and scan the code from its screen — or pick the device from the list the app has found.</string>

    <!-- Connection — the fork every route to a server starts from -->
    <string name="connect_title">Connection</string>
    <string name="connect_intro">Your phone connects straight to your computer. Choose how to find it.</string>
    <string name="connect_find_title">Find on the network</string>
    <string name="connect_find_description">Automatic search by several methods. Some will ask for permissions.</string>
    <string name="connect_scan_description">The code on your computer screen carries the address and the fingerprint at once. No permissions needed.</string>
    <string name="connect_manual_description">If you know the server\'s IP address and port.</string>
    <string name="connect_footer">Nothing has been started or requested yet.</string>

