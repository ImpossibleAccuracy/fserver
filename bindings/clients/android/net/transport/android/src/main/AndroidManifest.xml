<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Subnet scan: which networks are a LAN rather than a VPN or mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Local Network Protection: from API 37 every LAN packet is gated, so this covers the mDNS
      discovery, the direct-IP dialer and Nearby's WIFI_LAN medium alike. Declared here because this
      is the module that sends those packets.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        android:minSdkVersion="37"
        tools:targetApi="37" />

    <!-- Nearby Connections. Both are install-time, so neither reaches the user. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- The install-time bluetooth pair, superseded by the runtime trio the host declares. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

</manifest>
