<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Only what this module's own code calls, and only permissions the user is never asked about.

      Everything a transport or an optional feature needs is the host's to declare, even where
      RequirementRules.kt names it: a host that ships no Nearby UI should not inherit the nearby
      permission group by depending on this module. RequirementsCheckerImpl reports an undeclared
      permission as a blocker rather than as something the user could still grant.
    -->

    <!-- NetworkInfoRepositoryImpl - ConnectivityManager callbacks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      NetworkInfoRepositoryImpl reads WifiManager.connectionInfo; RequirementsCheckerImpl reads
      isWifiEnabled. Not capped at 31 the way Google's Nearby sample caps it - Nearby stops needing
      it, but reading the current network's details does not.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

</manifest>
