<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declared here, not in the consuming app: these are what the discovery datasources in this
      module need to run at all, so any UI that ships :core inherits them by manifest merge.
    -->

    <!--  Network discovery permissions  -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading which transport is up, and whether it carries a LAN. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Nearby Connections (P2P_* strategies) - needs Bluetooth, BLE and Wi-Fi radios.
      See https://developers.google.com/nearby/connections/android/get-started#request_permissions
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
      neverForLocation is load-bearing, not decoration: without it the platform keeps treating the
      BLE scan as location-derived, and the API 33+ rules in RequirementRules.kt - which stop asking
      for a location permission - would leave Nearby's BLE half silently finding nothing.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      No maxSdkVersion on purpose. BLE scanning only needs these up to API 32, but reading the
      network's name (SSID/BSSID) stays location-gated on every API - see networkInfoRequirementRules.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- API 33+: replaces the location gate for Wi-Fi Direct / Aware. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

</manifest>
