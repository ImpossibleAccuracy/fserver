-- What each source has already worked through on this device. `remoteIndexedFile` is the same
-- bookkeeping for what the peer reported, and the two are shaped alike on purpose.
--
-- Every row is a record of a handoff the engine already made - never a claim about bytes on disk.
--
-- state / hash / version are flattened into columns rather than pushed into `attribute`: a file's
-- state is a closed three-way split carrying at most one field, and a feed that pages and counts
-- needs them queryable. The attribute table is for the parts of a record that keep changing shape.
CREATE TABLE indexedFile (
    -- Assigned by whoever wrote the record. Unique across this device's whole index.
    id                  TEXT    NOT NULL,
    sourceId            TEXT    NOT NULL,
    -- Cross-device identity: the peer names the same file by the same value.
    fileId              TEXT    NOT NULL,
    path                TEXT    NOT NULL,
    -- Where the file lives in the local source. Local only - a peer addresses it differently.
    locator             TEXT    NOT NULL,
    -- Present | Evicted | Deleted. Evicted must never read back as Deleted: one freed space, the
    -- other is the user's deletion, and only the second one propagates.
    state               TEXT    NOT NULL,
    pinned              INTEGER NOT NULL DEFAULT 0,
    stateChangedEpochMs INTEGER,
    size                INTEGER NOT NULL,
    modifiedAtEpochMs   INTEGER NOT NULL,
    hashValue           TEXT,
    hashAlgorithm       TEXT,
    -- 1 once the file was touched after hashing: the hash is kept to compare with the next one.
    hashStale            INTEGER NOT NULL DEFAULT 0,
    -- Packed HLC reading of the version: tie-break only, never orders versions. Null with
    -- originDevice when the record has no version; the vector lives in indexedFileVersion.
    hlc                  INTEGER,
    originDevice         TEXT,
    processedAtEpochMs  INTEGER NOT NULL,
    -- What actually names a record: fileId alone is cross-device, so it identifies a row only
    -- paired with the source it was indexed under.
    PRIMARY KEY (sourceId, fileId)
);

CREATE UNIQUE INDEX indexedFile_id ON indexedFile(id);

selectAll:
SELECT *
FROM indexedFile;

selectBySource:
SELECT *
FROM indexedFile
WHERE sourceId = ?;

countBySource:
SELECT count(*)
FROM indexedFile
WHERE sourceId = ?;

-- Bytes of every file still on this device: an evicted file freed its space, a deleted one is gone.
sizeOfPresent:
SELECT coalesce(sum(size), 0)
FROM indexedFile
WHERE state = 'Present';

findByKey:
SELECT *
FROM indexedFile
WHERE sourceId = ? AND fileId = ?;

upsert:
INSERT OR REPLACE INTO indexedFile(
    id, sourceId, fileId, path, locator, state, pinned, stateChangedEpochMs,
    size, modifiedAtEpochMs, hashValue, hashAlgorithm, hashStale,
    hlc, originDevice, processedAtEpochMs
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE indexedFile
SET state = ?, pinned = ?, stateChangedEpochMs = ?
WHERE sourceId = ? AND fileId = ?;

deleteBySource:
DELETE FROM indexedFile
WHERE sourceId = ?;

-- One source's files by where they stand, for its details screen. Pending is what was indexed after
-- the last completed pass - the pass that would have sent it has not finished since.
sourceTotals:
SELECT
    (SELECT count(*) FROM indexedFile
        WHERE sourceId = :sourceId AND state = 'Present') AS hereFiles,
    (SELECT coalesce(sum(size), 0) FROM indexedFile
        WHERE sourceId = :sourceId AND state = 'Present') AS hereBytes,
    (SELECT count(*) FROM indexedFile l JOIN source s ON s.id = l.sourceId
        WHERE l.sourceId = :sourceId AND l.state = 'Present'
            AND l.processedAtEpochMs > coalesce(s.lastSyncedAtEpochMs, -1)) AS pendingFiles,
    (SELECT coalesce(sum(l.size), 0) FROM indexedFile l JOIN source s ON s.id = l.sourceId
        WHERE l.sourceId = :sourceId AND l.state = 'Present'
            AND l.processedAtEpochMs > coalesce(s.lastSyncedAtEpochMs, -1)) AS pendingBytes,
    (SELECT count(*) FROM indexedFile
        WHERE sourceId = :sourceId AND state = 'Evicted') AS evictedFiles,
    (SELECT coalesce(sum(size), 0) FROM indexedFile
        WHERE sourceId = :sourceId AND state = 'Evicted') AS evictedBytes,
    (SELECT count(*) FROM remoteIndexedFile
        WHERE sourceId = :sourceId AND state = 'Present') AS peerFiles,
    (SELECT coalesce(sum(size), 0) FROM remoteIndexedFile
        WHERE sourceId = :sourceId AND state = 'Present') AS peerBytes,
    (SELECT count(*) FROM indexedFile l JOIN remoteIndexedFile r
            ON r.sourceId = l.sourceId AND r.fileId = l.fileId
        WHERE l.sourceId = :sourceId AND l.state = 'Present' AND r.state = 'Present') AS matchedFiles,
    (SELECT coalesce(sum(l.size), 0) FROM indexedFile l JOIN remoteIndexedFile r
            ON r.sourceId = l.sourceId AND r.fileId = l.fileId
        WHERE l.sourceId = :sourceId AND l.state = 'Present' AND r.state = 'Present') AS matchedBytes;
